{
  "name": "homey-tp-link-managed-switch",
  "version": "0.1.10",
  "license": "MIT",
  "author": "Jamison Bennett",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamisonbennett/homey-tp-link-managed-switch.git"
  },
  "bugs": {
    "url": "https://github.com/jamisonbennett/homey-tp-link-managed-switch/issues"
  },
  "homepage": "https://github.com/jamisonbennett/homey-tp-link-managed-switch#readme",
  "main": "app.ts",
  "description": "A Homey app for managing TP-Link managed switches",
  "scripts": {
    "compose": "node -e \"require('./node_modules/homey/lib/HomeyCompose.js').buildIfUsed(require('./node_modules/homey/lib/App.js'), process.cwd()).catch(e=>{console.error(e);process.exit(1)})\"",
    "build": "npm run compose && npm run lint && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "eslint": "^10.8.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-homey-app": "^2.0.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^17.7.0",
    "homey": "4.2.3",
    "homey-apps-sdk-v3-types": "^0.3.12",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "keywords": [
    "homey",
    "tp-link",
    "switch",
    "smart home"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "overrides": {
    "got": "11.8.6",
    "homey-api": {
      ".": "3.20.1",
      "socket.io-client": "4.8.1",
      "engine.io-client": "6.6.4"
    },
    "test-exclude": "8.0.0",
    "formdata-node": "6.0.3",
    "tmp": "0.2.7",
    "sharp": "0.35.5",
    "uuid": "11.1.1",
    "ws": "8.21.0",
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.12",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  }
}
